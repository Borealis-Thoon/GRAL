+        private static ulong MixSeed(ulong seed)
+        {
+            unchecked
+            {
+                seed += 0x9E3779B97F4A7C15UL;
+                seed = (seed ^ (seed >> 30)) * 0xBF58476D1CE4E5B9UL;
+                seed = (seed ^ (seed >> 27)) * 0x94D049BB133111EBUL;
+                return seed ^ (seed >> 31);
+            }
+        }
